{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Matches tsconfig.base.json. The app's tsconfig also governs the engine packages it
    // imports through `paths`, so a lower target here would reject syntax those packages
    // legitimately use.
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "jsx": "react-jsx",
    "incremental": true,
    "verbatimModuleSyntax": false,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@xpplab/xpp-core": ["./packages/xpp-core/src/index.ts"],
      "@xpplab/xpp-lexer": ["./packages/xpp-lexer/src/index.ts"],
      "@xpplab/xpp-parser": ["./packages/xpp-parser/src/index.ts"],
      "@xpplab/xpp-runtime": ["./packages/xpp-runtime/src/index.ts"],
      "@xpplab/virtual-db": ["./packages/virtual-db/src/index.ts"],
      "@xpplab/virtual-db/metadata": ["./packages/virtual-db/src/metadata.ts"],
      "@xpplab/virtual-aot": ["./packages/virtual-aot/src/index.ts"],
      "@xpplab/renderers": ["./packages/renderers/src/index.ts"],
      "@xpplab/validators": ["./packages/validators/src/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "e2e/**/*.ts",
    "*.ts",
    "*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "packages", ".next"]
}
