{
  "name": "xpplab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "prepare:assets": "node scripts/copy-sql-wasm.mjs",
    "predev": "pnpm run prepare:assets",
    "dev": "next dev",
    "prebuild": "pnpm run prepare:assets",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "next typegen",
    "typecheck": "next typegen && tsc --noEmit && pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@mdx-js/loader": "^3.1.1",
    "@monaco-editor/react": "4.7.0",
    "@next/mdx": "^16.3.0",
    "@xpplab/renderers": "workspace:*",
    "@xpplab/validators": "workspace:*",
    "@xpplab/virtual-aot": "workspace:*",
    "@xpplab/virtual-db": "workspace:*",
    "@xpplab/xpp-core": "workspace:*",
    "@xpplab/xpp-lexer": "workspace:*",
    "@xpplab/xpp-parser": "workspace:*",
    "@xpplab/xpp-runtime": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "monaco-editor": "0.56.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
