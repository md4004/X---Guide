{
  "name": "xpplab",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": "\u003e=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typegen": "next typegen",
    "typecheck": "next typegen \u0026\u0026 tsc --noEmit \u0026\u0026 pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "pnpm run typecheck \u0026\u0026 pnpm run lint \u0026\u0026 pnpm run test"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@xpplab/renderers": "workspace:*",
    "@xpplab/validators": "workspace:*",
    "@xpplab/virtual-aot": "workspace:*",
    "@xpplab/virtual-db": "workspace:*",
    "@xpplab/xpp-core": "workspace:*",
    "@xpplab/xpp-lexer": "workspace:*",
    "@xpplab/xpp-parser": "workspace:*",
    "@xpplab/xpp-runtime": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "shadcn": "^4.16.2"
  }
}
